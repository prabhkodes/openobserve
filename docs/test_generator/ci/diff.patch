+    const obj = unloaded("timeout", ["plain"]);
+    const before = buildFilterContext(obj, zoConfig);
+    expect(planStreamsFilter("timeout", ["plain"], before)).toEqual({
+      kind: "sql",
+      filter: "timeout",
+    });
+
+    await loadPendingFreeTextSchemas(obj, async () => noFts("plain"));
